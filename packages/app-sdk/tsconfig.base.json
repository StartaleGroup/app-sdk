{
	"include": ["./src", "**/*.test.*"],
	"exclude": ["dist"],
	"compilerOptions": {
		"allowJs": true,
		"allowSyntheticDefaultImports": true,
		"rootDir": "./src",
		"outDir": "./dist",
		// `baseUrl` was removed in TypeScript 7 (TS5102) and `paths` values must
		// be relative (TS5090). Relative paths resolve against this file's
		// directory, which is what `baseUrl: "."` meant here — so behaviour is
		// unchanged on TS 5.x.
		"paths": {
			":util/*": ["./src/util/*"],
			":core/*": ["./src/core/*"],
			":store/*": ["./src/store/*"],
			":sign/*": ["./src/sign/*"],
			":ui/*": ["./src/ui/*"],
			":interface/*": ["./src/interface/*"]
		},
		"target": "es2017",
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"esModuleInterop": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"lib": ["dom", "esnext", "dom.iterable", "es2016"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"noErrorTruncation": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"types": ["node", "vitest/globals", "@testing-library/jest-dom"]
	}
}
